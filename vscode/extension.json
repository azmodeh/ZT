{
  "name": "zero-tolerance-bridge",
  "displayName": "Zero Tolerance Bridge",
  "description": "Integrates Zero Tolerance contract hooks with VS Code assistants.",
  "version": "0.1.0",
  "hooks": {
    "preRequest": "./hooks/pre_request.js",
    "postResponse": "./hooks/post_response.js"
  },
  "defaults": {
    "model": "mistralai/mixtral-8x7b",
    "temperature": 0.2
  },
  "environment": {
    "OPENROUTER_API_KEY": "env:OPENROUTER_API_KEY",
    "AI_MODEL": "mistralai/mixtral-8x7b"
  }
}
