      "type": "shell",
      "command": "${config:python.pythonPath}",
      "args": [
        "enforcement/ai_queue.py"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": false
      },
      "options": {
        "cwd": "d:/Workdir/ZeroToleranceSystem/ZT"
