{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ZT: Validate Contract",
      "type": "shell",
      "command": "${config:python.pythonPath}",
      "args": [
        "enforcement/validator.py"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": false
      },
      "options": {
        "cwd": "d:/Workdir/ZeroToleranceSystem/ZT"
      }
    },
    {
      "label": "ZT: Auto Rewrite",
      "type": "shell",
      "command": "${config:python.pythonPath}",
      "args": [
        "enforcement/rewriter.py"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": false
      },
      "options": {
        "cwd": "d:/Workdir/ZeroToleranceSystem/ZT"
      }
    },
    {
      "label": "ZT: Build AI Index",
      "type": "shell",
      "command": "${config:python.pythonPath}",
      "args": [
        "enforcement/ai_indexer.py"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": false
      },
      "options": {
        "cwd": "d:/Workdir/ZeroToleranceSystem/ZT"
      }
    },
    {
